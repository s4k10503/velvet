/*
 * Text input colours - caret-*, selection:bg-* and selection:text-* (StyleTextInputColors).
 *
 * The utilities are resolved from C#, from the class lists of a text input's own box and control and of
 * their ancestors, whenever the input's text element finishes a style pass. StyleTextInputColors marks
 * that text element with this class and registers the callback the pass's custom-style event reaches;
 * this rule gives it the custom property the event also needs, which TextInputColorUtilityTests pins.
 */

.velvet-text-input { --velvet-text-input-colors: 1; }
