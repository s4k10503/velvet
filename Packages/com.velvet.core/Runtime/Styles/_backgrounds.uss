/* Background Utilities - background-repeat, -unity-slice-type (the background colours are in _palette.uss) */

/* Tailwind's bg-repeat family */
.bg-no-repeat { background-repeat: no-repeat; }
.bg-repeat { background-repeat: repeat; }
.bg-repeat-round { background-repeat: round; }
.bg-repeat-space { background-repeat: space; }
.bg-repeat-x { background-repeat: repeat-x; }
.bg-repeat-y { background-repeat: repeat-y; }

/* The nine-slice fill mode. The insets and their scale are arbitrary values resolved in C#
   (slice-[12], slice-scale-[2]); Documentation~/styling-backgrounds.md owns the family. */
.slice-sliced { -unity-slice-type: sliced; }
.slice-tiled { -unity-slice-type: tiled; }

/* Gives an element declaring a percentage slice inset the custom property that makes UI Toolkit send it
   CustomStyleResolvedEvent; see StyleArbitraryValueResolver.WatchShownImage. */
.velvet-slice-percent { --velvet-slice-percent: 1; }
