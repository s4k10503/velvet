.layout-id-test-fade {
    transition-property: opacity;
    transition-duration: 1s;
    transition-timing-function: linear;
}

.layout-id-test-round {
    border-radius: 10px;
}

.layout-id-test-rounder {
    border-radius: 20px;
}

.layout-id-test-fade-delayed {
    transition-property: opacity;
    transition-duration: 1s;
    transition-delay: 0.2s;
    transition-timing-function: linear;
}
