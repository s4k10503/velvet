.layout-id-test-fade {
    transition-property: opacity;
    transition-duration: 1s;
    transition-timing-function: linear;
}

.layout-id-test-round {
    border-radius: 10px;
}

.layout-id-test-rounder {
    border-radius: 20px;
}

.layout-id-test-fade-delayed {
    transition-property: opacity;
    transition-duration: 1s;
    transition-delay: 0.2s;
    transition-timing-function: linear;
}

.layout-id-test-two {
    transition-property: background-color, opacity;
    transition-duration: 0.2s, 1s;
    transition-timing-function: linear;
}

.layout-id-test-fade-early {
    transition-property: opacity;
    transition-duration: 1s;
    transition-delay: -0.2s;
    transition-timing-function: linear;
}

.layout-id-test-uneven {
    border-top-left-radius: 90px;
    border-top-right-radius: 30px;
}

.layout-id-test-radius-transition {
    transition-property: border-radius;
    transition-duration: 1s;
    transition-timing-function: linear;
}

.layout-id-test-move-two {
    transition-property: translate, background-color;
    transition-duration: 1s, 0.2s;
    transition-timing-function: linear;
}

.layout-id-test-delay-only {
    transition-property: translate;
    transition-duration: 0s;
    transition-delay: 0.3s;
}

.layout-id-test-turn {
    transition-property: rotate;
    transition-duration: 1s;
    transition-timing-function: linear;
}
