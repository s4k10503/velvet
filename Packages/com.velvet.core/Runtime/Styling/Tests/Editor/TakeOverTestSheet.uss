/* Rules whose timing function is a keyword, which StyleEaseCurveTakeOverTests takes transitions over by. */
.take-over-ease-in-out {
    transition-property: opacity, rotate, translate, scale, border-top-left-radius;
    transition-duration: 1s;
    transition-delay: -0.3s;
    transition-timing-function: ease-in-out;
}

.take-over-linear {
    transition-property: opacity;
    transition-duration: 1s;
    transition-delay: -0.3s;
    transition-timing-function: linear;
}
