/* Rules StyleEaseCurveTransitionTests runs transitions by: a keyword timing function each, and one pairing two
   durations with two properties, whose narrowing writes the timing lists inline. */
.ease-in-out-test {
    transition-property: width;
    transition-duration: 1s;
    transition-timing-function: ease-in-out;
}

.ease-in-test {
    transition-property: width;
    transition-duration: 1s;
    transition-timing-function: ease-in;
}

.paired-timing-test {
    transition-property: background-color, opacity;
    transition-duration: 0.2s, 1s;
    transition-timing-function: linear;
}
