/* A project sheet whose root rule gives every longhand a host root holds a value other than its initial one, and a
   colour its children inherit. PortalHostCarryTests reads it. */
:root {
    background-color: #ff0000;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    padding-top: 16px;
    padding-right: 16px;
    padding-bottom: 16px;
    padding-left: 16px;
    margin-top: 7px;
    margin-right: 7px;
    margin-bottom: 7px;
    margin-left: 7px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    align-content: center;
    justify-content: center;
    opacity: 0.5;
    display: none;
    overflow: hidden;
    translate: 5px 5px;
    rotate: 10deg;
    scale: 2 2;
    position: relative;
    left: 11px;
    top: 11px;
    right: 11px;
    bottom: 11px;
    width: 50px;
    height: 40px;
    min-width: 900px;
    min-height: 900px;
    max-width: 10px;
    max-height: 10px;
    color: #00ff00;
}
