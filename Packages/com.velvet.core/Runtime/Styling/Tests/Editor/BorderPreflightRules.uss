/* Rules BorderPreflightTests reads: each sets a border colour the way an author's stylesheet does, under a selector of
   one form, so that preflight's currentcolor has to give way to every one of them. */
.pf-transparent { border-color: transparent; }

#pf-id { border-color: rgb(0, 0, 255); }

.pf-hover:hover { border-color: rgb(0, 255, 0); }

.pf-top { border-top-color: rgb(255, 0, 0); }

.pf-ancestor .pf-descendant { border-color: rgb(255, 255, 0); }

.pf-width { border-width: 2px; }

.pf-width-colored { border-width: 2px; border-color: rgb(0, 0, 255); }

.pf-plain { background-color: rgb(1, 2, 3); }

#pf-width-id { border-top-width: 1px; }

.pf-hover-width:hover { border-width: 2px; }

.pf-open .pf-item { border-bottom-width: 1px; }

.pf-zero { border-width: 0; }

.pf-initial { border-width: initial; }
