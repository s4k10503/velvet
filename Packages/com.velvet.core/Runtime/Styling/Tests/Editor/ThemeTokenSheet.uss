/* Variables ThemeTokenClassTests reads: tokens a project sheet declares, and a theme class redeclaring one. */
.theme-token-host {
    --color-brandtest: rgb(255, 0, 102);
    --radius-pilltest: 40px;
    --spacing: 3px;
    --spacing-guttertest: 10px;
    --spacing-7: 10px;
    --text-sizetest: 20px;
    --text-sizetest--line-height: 1.5;
    --text-sm--line-height: 2;
    --breakpoint-xstest: 30rem;
    --container-widetest: 100rem;
    --breakpoint-sm: 50rem;
    --breakpoint-3xltest: 120rem;
    --animate-wiggletest: kf-theme 2s linear infinite;
    --inset-shadow-glowtest: 0 0 4px rgb(255, 0, 0);
}

.theme-token-host.theme-token-alt {
    --color-brandtest: rgb(0, 255, 0);
}
