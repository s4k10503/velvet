<Project>

  <!--
    Two of the assemblies built here are committed under ../Runtime/Plugins, so their bytes have to
    follow from the sources beside them and the pinned toolchain alone. Without this the SDK queries
    git and writes the commit id into the assembly, which rewrites binaries whose sources did not move
    and makes a rebuild-and-compare answer "different" unless it runs at the very commit the binary was
    built at. It is not the only such input — each deployed project drops its Release PDB for the
    second one, and says so where it does. scripts/generators/deployed_dll_check.py is what fails when
    either stops holding, and it compares a build made on Linux against a binary built on a
    contributor's machine, so it holds the SourceRoot below too.
  -->
  <PropertyGroup>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
  </PropertyGroup>

  <!--
    Declared rather than taken from the queries above, because ContinuousIntegrationBuild rewrites
    source paths against it: with neither, the build succeeds and embeds the absolute path of whoever
    ran it.
  -->
  <ItemGroup>
    <SourceRoot Include="$(MSBuildThisFileDirectory)" />
  </ItemGroup>

</Project>
