<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The mutation campaign's schemata rewriter, scripts/test_quality/schemata/MutantSchemata.cs, compiled
    into this test assembly. The campaign builds it with the editor's own compiler instead; this is where
    its placement is tested.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <RootNamespace>Velvet.MutantSchemata.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="Velvet.CodeShape" Value="enforce" />
    <ProjectReference Include="..\..\src\Velvet.SourceGenerators.Bootstrap\Velvet.SourceGenerators.Bootstrap.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\..\..\scripts\test_quality\schemata\MutantSchemata.cs" Link="MutantSchemata.cs" />
  </ItemGroup>

</Project>
