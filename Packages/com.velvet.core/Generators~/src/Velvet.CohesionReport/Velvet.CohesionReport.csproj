<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Velvet.CohesionReport</RootNamespace>
    <AssemblyName>Velvet.CohesionReport</AssemblyName>
    <Description>Prints syntax-level cohesion and coupling rankings over the package's non-test sources.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Velvet.SourceGenerators.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="Velvet.CodeShape" Value="enforce" />
    <ProjectReference Include="..\Velvet.SourceGenerators.Bootstrap\Velvet.SourceGenerators.Bootstrap.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
