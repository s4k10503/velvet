<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <RootNamespace>Velvet.SourceGenerators</RootNamespace>
    <AssemblyName>Velvet.SourceGenerators</AssemblyName>
    <Version>0.1.0</Version>
    <Authors>s4k10503</Authors>
    <Description>Roslyn Incremental Source Generators for the Velvet Unity package.</Description>
    <!-- PathMap normalizes source paths to /_/, so the DLL does not carry the machine it was built on, and
         two builds at one commit are byte-identical. Two builds at different commits are not: the SDK
         appends the commit SHA to AssemblyInformationalVersion. That comes from
         IncludeSourceRevisionInInformationalVersion, which is on by default and independent of both
         properties set here — turning either of them off leaves the SHA in place, and turning that one off
         removes it. So the committed artifact carries the SHA of the commit before the one carrying it, and
         nothing can check the deployed DLL against a rebuild of these sources. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Unity 6's Roslyn host is 4.3.0, so the Generator side must match.
         Referencing 4.8.0 raises CS9057 and breaks generator loading. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Velvet.SourceGenerators.Tests" />
    <InternalsVisibleTo Include="Velvet.SourceGenerators.CodeFixes" />
  </ItemGroup>

  <ItemGroup>
    <!-- The code-shape rules this project implements, applied to it. `Velvet.SourceGenerators.Bootstrap`
         owns why the analyzers arrive from a second compile rather than from this one. -->
    <AssemblyMetadata Include="Velvet.CodeShape" Value="enforce" />
    <ProjectReference Include="..\Velvet.SourceGenerators.Bootstrap\Velvet.SourceGenerators.Bootstrap.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
