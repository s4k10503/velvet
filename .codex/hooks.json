{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/harness/adapter.py\" codex SessionStart report/stale_main.py",
            "timeout": 15.0,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/harness/adapter.py\" codex SessionStart report/wedged_processes.py",
